# Environment Configuration Template for Heaven_Python

PORT=3009
ENVIRONMENT=development

# MongoDB Connection String (Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster1.mongodb.net/HavenTo?retryWrites=true&w=majority
DATABASE_NAME=HavenTo

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Email Service (Gmail OAuth2 & SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token

# AI Agent Keys (Groq / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
